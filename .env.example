# Copy to .env and fill in. Never commit .env.

# --- Your SDP site ---
SDP_BASE_URL=https://help.example.com

# --- Zoho OAuth (Self Client) — recommended for SDP Cloud / On-Demand ---
# From a Self Client in the Zoho API console (https://console.zoho.com):
SDP_CLIENT_ID=1000.XXXXXXXXXXXXXXXXXXXXXXXXXX
SDP_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Data center of your client. US=com, EU=eu, IN=in, AU=au, CN=cn
SDP_ACCOUNTS_SERVER=https://accounts.zoho.com

# Bootstrap the refresh token ONCE (uses the one-time code from the client's
# "Generate Code" tab), then paste the printed line here:
#   python sdp_mcp.py exchange <authorization-code>
SDP_REFRESH_TOKEN=

# --- Alternative: plain authtoken (on-prem / legacy). Leave blank if using OAuth ---
SDP_AUTHTOKEN=
